DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# Database
DB_NAME=MILAL_DB
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_DRIVER=ODBC Driver 18 for SQL Server

# Authentication mode:
# windows          -> local Windows Integrated Security
# sql              -> SQL username/password
# managed_identity -> Azure App Service Managed Identity
DB_AUTH_MODE=windows

DB_USER=
DB_PASSWORD=

# Local SQL Server can require yes.
# Azure production must use no.
DB_TRUST_SERVER_CERTIFICATE=yes

DB_CONNECTION_TIMEOUT=30
DB_CONNECTION_RETRIES=3
DB_CONNECTION_RETRY_BACKOFF_TIME=5
DB_QUERY_TIMEOUT=120

# Local development can keep 0.
# Production can use 300.
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=True

# Private Azure Blob Storage
# False keeps using backend/private_media locally.
AZURE_STORAGE_ENABLED=False
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_PRIVATE_CONTAINER=student-documents
AZURE_STORAGE_MAX_MEMORY_SIZE=5242880

# Password recovery and email
# Development only. Configure a real email backend in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@milal.org.gt
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/password-reset

# Artificial intelligence
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
AI_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=45

# OpenAI
OPENAI_API_KEY=

# Ollama fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
